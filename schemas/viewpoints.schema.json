{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junixlabs/uxcli/schemas/viewpoints.schema.json",
  "title": "uxcli viewpoints pool",
  "description": "One school's viewpoints — skills/uxcli/lenses/viewpoints/<school>.json. Each is a named designer's rule with the page it was read from; a lens for a kind of UI picks from these.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "school", "name", "research", "viewpoints"],
  "properties": {
    "schema_version": { "const": 1 },
    "school": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "research": { "type": "string", "minLength": 1, "description": "the research file the pool was distilled from" },
    "viewpoints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "claim", "source", "evidence", "prefers", "forbids", "measure", "kinds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9]+(-[a-z0-9]+)*$" },
          "claim": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object", "additionalProperties": false, "required": ["author", "work", "url", "quote"],
            "properties": { "author": { "type": "string", "minLength": 1 }, "work": { "type": "string", "minLength": 1 }, "url": { "type": "string", "pattern": "^https?://" }, "quote": { "type": "string" } }
          },
          "evidence": { "enum": ["study", "author", "secondary", "folklore"] },
          "prefers": { "type": "array", "items": { "type": "string" } },
          "forbids": { "type": "array", "items": { "type": "string" } },
          "measure": {
            "type": "object", "additionalProperties": false, "required": ["kind", "what"],
            "properties": { "kind": { "enum": ["count", "question"] }, "what": { "type": "string", "minLength": 1 }, "mustFail": { "type": "string" }, "mustPass": { "type": "string" }, "probe": { "type": "string", "pattern": "^page\\.[a-z-]+$", "description": "the shipped probe that counts it, when one exists" } }
          },
          "exceptions": { "type": "array", "items": { "type": "string" } },
          "kinds": {
            "type": "object", "additionalProperties": false, "required": ["marketing", "content", "data", "workspace", "shop", "transaction"],
            "properties": { "marketing": { "enum": ["yes", "no", "maybe"] }, "content": { "enum": ["yes", "no", "maybe"] }, "data": { "enum": ["yes", "no", "maybe"] }, "workspace": { "enum": ["yes", "no", "maybe"] }, "shop": { "enum": ["yes", "no", "maybe"] }, "transaction": { "enum": ["yes", "no", "maybe"] } }
          },
          "kindsWhy": { "type": "string" },
          "agrees": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
