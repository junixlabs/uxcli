{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junixlabs/uxcli/schemas/actor.schema.json",
  "title": "uxcli actor",
  "description": "Who the product is for, as behaviour that can be pointed at — .uxcli/understanding/actors/<actor>.json. unknowns[] may not be empty.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "description": "the name journeys use in their `actor` field"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "habits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unknowns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "questions that would settle what is not known; the most important field"
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
