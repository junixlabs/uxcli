{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/junixlabs/uxcli/schemas/kit.schema.json",
  "title": "Design kit",
  "description": ".uxcli/designer/kits/<id>.json, written by uxcli designer propose --write: the library and packages for a catalog formula, the tokens as DTCG 2025.10 data with their contrast checked, the library's theme keys, the component for each region of each chosen layout, a folder structure, the rules and the checks before done. A proposal, not code.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "formula",
    "checked",
    "library",
    "modes",
    "steps",
    "tokens",
    "contrast",
    "cvd",
    "theme",
    "patterns",
    "structure",
    "rules",
    "checks",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "formula": {
      "type": "string",
      "minLength": 1
    },
    "checked": {
      "type": "string"
    },
    "library": {
      "type": "object",
      "required": [
        "id",
        "name",
        "why",
        "alternatives",
        "packages",
        "theming",
        "dark",
        "density",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "antd",
            "shadcn",
            "mui",
            "mantine"
          ]
        },
        "name": {
          "type": "string"
        },
        "why": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "version",
              "role"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+"
              },
              "role": {
                "type": "string"
              }
            }
          }
        },
        "theming": {
          "type": "string"
        },
        "density": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dark": {
          "type": "string"
        }
      }
    },
    "tokens": {
      "type": "object",
      "required": [
        "color",
        "dimension",
        "font"
      ]
    },
    "contrast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mode",
          "fg",
          "bg",
          "ratio",
          "min",
          "ok"
        ],
        "additionalProperties": false,
        "properties": {
          "fg": {
            "type": "string"
          },
          "bg": {
            "type": "string"
          },
          "ratio": {
            "type": "number"
          },
          "min": {
            "type": "number"
          },
          "ok": {
            "const": true
          },
          "mode": {
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      }
    },
    "theme": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "token",
          "light",
          "dark"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "token": {
            "type": "string"
          },
          "light": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "dark": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "layout",
          "name",
          "use",
          "regions",
          "checks"
        ],
        "additionalProperties": false,
        "properties": {
          "layout": {
            "type": "string",
            "pattern": "^B-"
          },
          "name": {
            "type": "string"
          },
          "use": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "regions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "region",
                "component",
                "note"
              ],
              "additionalProperties": false,
              "properties": {
                "region": {
                  "type": "string"
                },
                "component": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "note": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "structure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic",
          "rule",
          "check"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "severity",
          "check"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "check": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "light",
          "dark"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "string"
      }
    },
    "cvd": {
      "type": "object",
      "description": "Per mode: status pairs simulated under protanopia, deuteranopia and tritanopia, and the ones closer than minDelta."
    }
  }
}
