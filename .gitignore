# local agent workspace, never committed — except the rules and skills, which are the
# project's own instructions to whoever (or whatever) works on it next
.claude/*
!.claude/rules/
!.claude/skills/

node_modules
.DS_Store
*.log
# the repo's own .uxcli/: declarations travel with the repo, everything observed or derived (and the old
# per-site run dirs) stays out; in a nested project only observed/derived stay out
/.uxcli/*
!/.uxcli/project.json
!/.uxcli/policy/
!/.uxcli/understanding/
!/.uxcli/journeys/
!/.uxcli/commitments/
!/.uxcli/profiles/
!/.uxcli/probes/
!/.uxcli/corpus/
**/.uxcli/runs/
**/.uxcli/proposals/
**/.uxcli/index.json

# holds a storefront bearer token
.mcp.json
.playwright-mcp/

# regenerable: uxcli propose rewrites these from the last run
uxcli.*.proposed.json
