# local agent workspace, never committed — except the rules and skills, which are the
# project's own instructions to whoever (or whatever) works on it next
.claude/*
!.claude/rules/
!.claude/skills/

node_modules
.DS_Store
*.log
# the repo's own .uxcli/ (old runs, index) stays out; in a nested project only observed/derived stay out — declarations travel with the repo
/.uxcli/
**/.uxcli/runs/
**/.uxcli/proposals/
**/.uxcli/index.json

# holds a storefront bearer token
.mcp.json
.playwright-mcp/

# regenerable: uxcli propose rewrites these from the last run
uxcli.*.proposed.json
