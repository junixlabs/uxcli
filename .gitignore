# local agent workspace, never committed — except the rules and skills, which are the
# project's own instructions to whoever (or whatever) works on it next
.claude/*
!.claude/rules/
!.claude/skills/

node_modules
.DS_Store
*.log
# the repo's own .uxcli/: authored and derived-persistent files travel with the repo; observed runs
# and the rebuildable index stay out. Proposals are tracked: a commitment cites the proposal it came
# from, and a citation to a file that is not there is a broken signature. examples/crm/.uxcli/ is the
# shape contract and ships whole, runs included.
/.uxcli/runs/
/.uxcli/index.json
test/fixtures/crm/.uxcli/runs/
test/fixtures/crm/.uxcli/index.json

# holds a storefront bearer token
.mcp.json
.playwright-mcp/

# regenerable: uxcli propose rewrites these from the last run
uxcli.*.proposed.json

# experiment transcripts are 29 MB of tool-call logs; session.json, lead.html and summary.md carry the measurement
experiments/*/results/*/transcript.jsonl

# regenerable in seconds: uxcli mockups photographs the variants and writes the page
**/.uxcli/mockups/.shots/
**/.uxcli/mockups/index.html
**/.uxcli/map/
**/.uxcli/studio/
**/.uxcli/experience/

# experiment results stay on the machine that ran them
experiments/*/results/
