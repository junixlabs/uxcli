  "structure": [
    "src/theme/tokens.json  (this kit's tokens)",
    "src/theme/theme.ts  (the Ant Design 6 theme, keys as below)",
    "src/components/  (a component at its second use)",
    "src/features/<area>/  (screens, by what the person does)"
  ],
  "rules": [
    {
      "id": "colour-roles",
      "rule": "Colour has fixed roles: a neutral ground, one action colour and four status colours (critical, warning, success, info). No colour outside a role.",
      "check": "List the tokens; count colours used outside them — zero."
    },
    {
      "id": "one-meaning",
      "rule": "One colour, one meaning across the product; the action colour is not a status colour.",
      "check": "Compare the colour-to-meaning table between screens."
    },
    {
      "id": "quiet-normal",
      "rule": "The normal state is quiet; only what needs attention carries colour.",
      "check": "The share of rows with a warm status chip on one screen stays low."
    },
    {
      "id": "few-codes",
      "rule": "At most five to seven status colours per entity, and about four new colour codes to learn per screen.",
      "check": "Count them."
    },
    {
      "id": "never-colour-alone",
      "rule": "Colour is never the only signal: a short word or an icon always goes with it.",
      "check": "In greyscale every state is still told apart."
    },
    {
      "id": "contrast",
      "rule": "Text 4.5:1, large text and component parts 3:1, in light and dark.",
      "check": "Measure automatically."
    },
    {
      "id": "scales",
      "rule": "About four type sizes on one scale and spacing from one scale; space between groups is clearly larger than space within them.",
      "check": "Count the distinct values in the CSS."
    },
    {
      "id": "one-primary",
      "rule": "One dominant element and one primary button per screen.",
      "check": "Squint test; count primary buttons."
    },
    {
      "id": "space-lines-boxes",
      "rule": "Separate with space first, a line second, a box last; no box inside a box.",
      "check": "Count nested boxed layers."
    },
    {
      "id": "first-screen",
      "rule": "The most important thing is on the first screen; long pages have headings that read alone; no scroll box inside a scrolling page.",
      "check": "Position of the main element against 100vh; count nested scroll areas."
    },
    {
      "id": "table-card-list",
      "rule": "Compare in a table, browse independent items with pictures in cards, read in order in a list.",
      "check": "Check against what the person does on the screen."
    },
    {
      "id": "table-basics",
      "rule": "Tables: numbers right-aligned in tabular figures, text left, one unit per column, sort state visible, sticky header, empty and loading states.",
      "check": "Check column by column."
    }
  ],
  "checks": [
    {
      "id": "bulk-visible-only",
      "kind": "bug",
      "severity": "S1",
      "check": "Bulk actions touch only the rows the filter shows; filtering cuts the selection in the same render."
    },
    {
      "id": "bulk-server-allowed",
      "kind": "contract",
      "severity": "S2",
      "check": "Bulk sends only rows the server marked as allowed, and says beforehand how many are skipped and why."
    },
    {
      "id": "selection-across-pages",
      "kind": "usability",
      "severity": "N3",
      "check": "With pagination, the selection bar says which page the selection is on and offers \"select all N\"."
    },
    {
      "id": "no-nested-scroll",
      "kind": "usability",
      "severity": "N2",
      "check": "The table is not its own scroll box inside a scrolling page; the header sticks, the pager sticks."
    },
    {
      "id": "sort-visible",
      "kind": "usability",
      "severity": "N2",
      "check": "Sort arrows are always visible, faintly, not only on hover."
    },
    {
      "id": "drop-flat-columns",
      "kind": "usability",
      "severity": "N1",
      "check": "A column holding one value in 80% or more of rows is dropped or merged; no \"Open\" button column when the name is a link."
    },
    {
      "id": "tier-one-on-top",
      "kind": "usability",
      "severity": "N3",
      "check": "Identity, status, next action and what is overdue sit on top; standing explanatory paragraphs go behind a \"?\"."
    },
    {
      "id": "alert-with-fix",
      "kind": "usability",
      "severity": "N3",
      "check": "Every alert carries the way to fix it right there."
    },
    {
      "id": "no-dead-links",
      "kind": "usability",
      "severity": "N3",
      "check": "No link leads to a refusal (403) or nothing (404); say why in words instead."
    },
    {
      "id": "default-view-has-data",
      "kind": "usability",
      "severity": "N2",
      "check": "A screen does not open on an empty view while the view beside it has data."
    },
    {
      "id": "refusals-in-words",
      "kind": "contract",
      "severity": "S2",
      "check": "A refusal shows a sentence from one shared table of reason codes, never a raw code or the backend's English."
    },
    {
      "id": "read-the-backend",
      "kind": "contract",
      "severity": "S2",
      "check": "Field names of errors and allowlists are read from the backend code, not guessed; \"\" clears a field, it is not \"do not send\"."
    },
    {
      "id": "why-on-rule-errors",
      "kind": "usability",
      "severity": "N2",
      "check": "An error caused by a business rule links to \"Why?\" explained in place; an input error does not."
    },
    {
      "id": "no-typed-codes",
      "kind": "usability",
      "severity": "N3",
      "check": "Nobody types a reason code; offer sentences with the code behind them; a choice list over ten items has search."
    },
    {
      "id": "dialog-cancel",
      "kind": "usability",
      "severity": "N2",
      "check": "Long create or edit forms open in a dialog or a page, never inline pushing the page down; a writing dialog ends with \"Cancel\", a reading one with \"Close\"."
    },
    {
      "id": "open-every-layer",
      "kind": "bug",
      "severity": "S1",
      "check": "Open every overlay (select, popover, dialog) and confirm it has content; reading text on the page is not enough."
    },
    {
      "id": "layer-order",
      "kind": "bug",
      "severity": "S2",
      "check": "A select or popover opened in a dialog sits above the dialog's backdrop; every floating layer has its own z-index."
    },
    {
      "id": "tokens-in-dark",
      "kind": "a11y",
      "severity": "S2",
      "check": "Text and ground colours go through tokens; open dark mode and measure contrast."
    },
    {
      "id": "no-sideways-scroll",
      "kind": "a11y",
      "severity": "S2",
      "check": "No horizontal scroll at 390px; header button rows may wrap. Check 1920, 1280, 860 and 390."
    },
    {
      "id": "no-button-in-button",
      "kind": "a11y",
      "severity": "S2",
      "check": "No button inside a button; a long screen-reader name goes in aria-label, not in visible text."
    },
    {
      "id": "one-word-one-meaning",
      "kind": "usability",
      "severity": "N2",
      "check": "One word, one meaning per screen; buttons with one role share one label; one way of saying \"empty\"."
    },
    {
      "id": "component-at-second-use",
      "kind": "debt",
      "severity": "-",
      "check": "Sizes, weights and colours come from tokens; markup used on a second screen becomes a component."
    },
    {
      "id": "count-boxes",
      "kind": "usability",
      "severity": "N1",
      "check": "Count boxed nesting before showing a page: space first, lines next, boxes last."
    },
    {
      "id": "measure-not-eyeball",
      "kind": "drift",
      "severity": "N2",
      "check": "When a prototype exists, compare the build by measurement, not by eye."
    }
  ],
  "warnings": [
    "G2 with A07: Mobile first rarely suits desktop work screens; consider G1, still responsive."
  ]
}
